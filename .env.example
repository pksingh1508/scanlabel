# Public client configuration may be added later with EXPO_PUBLIC_ names.
# Never place OPENROUTER_API_KEY in a client-accessible variable.

# Server-only analysis configuration (used from Step 8 onward).
OPENROUTER_API_KEY=
# Cost-efficient default verified 2026-09-03 for vision input + structured
# outputs: google/gemini-2.5-flash-lite. Leave empty to use the in-code
# default; override anytime without touching the mobile client.
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ScanLabel

ANALYSIS_MAX_IMAGES=2
ANALYSIS_TIMEOUT_MS=30000
